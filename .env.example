# VIP KEVAS - Modèle de configuration Supabase
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_PROJECT_ID=<your-project-ref>
SUPABASE_ACCESS_TOKEN=<your-personal-access-token>

# Service de Notifications Email Brevo (Billet PDF + Rappels de Départ Moins de 2h / Moins de 1h)
# Obtenez votre clé API gratuite sur https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=vidalkadjou880@gmail.com
BREVO_SENDER_NAME="VIP Connect Transport Agency"

# Passerelle de Paiement Sécurisée (Clés Privées gérées UNIQUEMENT côté serveur)
# Ne jamais exposer ces clés secrètes dans le navigateur ou côté client
PAYMENT_PROVIDER=Orange_MTN_Or_Aggregator
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PORT=3000
